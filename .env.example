# Google Drive picker (client-side). Copy to `.env.local` and fill in real values.
# Both are PUBLIC values — restrict them by origin in Google Cloud Console.
# The "From Google Drive" button only appears when BOTH are set.

# OAuth 2.0 Web client ID (Authorized JavaScript origins must include your app URLs,
# e.g. http://localhost:5173, http://localhost:4173, and your production URL).
VITE_GOOGLE_CLIENT_ID=praveer.kumar@ss-prophet.com

# API key (developer key) with the Google Picker API + Google Drive API enabled.
VITE_GOOGLE_API_KEY=
